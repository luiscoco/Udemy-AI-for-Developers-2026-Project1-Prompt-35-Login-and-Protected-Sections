# Local SQL Server connection string used by Prisma.
#
# SQL auth example (SQL Server running on localhost, default instance,
# TCP port 1433, a database named equipment_hub already created or to be
# created by `prisma migrate dev`):
# DATABASE_URL="sqlserver://localhost:1433;database=equipment_hub;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"
#
# Windows/integrated auth example (uses the credentials of the user running
# the process instead of a SQL login):
# DATABASE_URL="sqlserver://localhost:1433;database=equipment_hub;integratedSecurity=true;trustServerCertificate=true"
#
# Named instance example:
# DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=equipment_hub;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"
DATABASE_URL="sqlserver://localhost:1433;database=equipment_hub;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

# Secret used to sign and verify login JWTs. Use a long random value, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
